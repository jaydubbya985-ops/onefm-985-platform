# ─────────────────────────────────────────────────────────
#  ONE FM 98.5 — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
# When configured, Ops portal uses Supabase Auth (staff email/password).
# Without these, Ops falls back to demo mode (password: onefm2026).
# Production: paste the same two keys in Netlify → Site settings → Environment
# variables. After ops-config is deployed, #/ops reads them at runtime (no
# GitHub Actions rebuild required to leave DEMO).
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# Publishable key (recommended): sb_publishable_...
# Legacy anon JWT also works: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=your-publishable-key-here

# ── OpenAI (AI proposal/caption/forecast features) ────────
# Get from: https://platform.openai.com/api-keys
# Leave blank to use demo mode (no real AI calls)
VITE_OPENAI_API_KEY=sk-...

# ── Stripe (payments & invoicing) ─────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
# For testing, use your pk_test_ key. For production, use pk_live_.
# Stripe account: acct_1J696RS3NlaEohlL
# Bank: BSB 083-894 | Account 553 219 432 | Name: 98.5 One FM
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Secret key — BACKEND ONLY, never expose in frontend
# STRIPE_SECRET_KEY=sk_live_...

# ── Email Service (Resend) ──────────────────────────────────
# Production: set as Supabase Edge Function secrets (NOT in frontend):
#   supabase secrets set RESEND_API_KEY=re_...
#   supabase secrets set RESEND_FROM="ONE FM 98.5 <accounts@fm985.com.au>"
#   supabase secrets set STATION_EMAIL=admin@fm985.com.au
#
# Dev-only fallback (optional — exposes key in browser bundle):
# VITE_RESEND_API_KEY=re_...

# ── Google Maps (Coverage Map page) ───────────────────────
# Get from: https://console.cloud.google.com → Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=AIza...

# ── Station Config ────────────────────────────────────────
VITE_STATION_NAME="ONE FM 98.5"
VITE_STATION_FREQUENCY="98.5"
VITE_STATION_CITY="Shepparton"
VITE_STATION_STATE="VIC"
VITE_STATION_COUNTRY="Australia"
VITE_STATION_EMAIL="admin@fm985.com.au"
VITE_STATION_PHONE="+61358313131"
# Live stream (Radio.co — same as fm985.com.au/audio-player/)
VITE_RADIO_CO_STATION_ID="sae3372059"
VITE_STREAM_URL="https://s2.radio.co/sae3372059/listen"
